PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/devops-agent
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
CLOUDFLARE_TUNNEL_MODE=quick
CLOUDFLARE_TUNNEL_START_TIMEOUT_MS=30000
# Optional path to cloudflared.exe when it is not on PATH
# CLOUDFLARED_PATH=C:\\Program Files\\cloudflared\\cloudflared.exe
